[Unit]
Description=SwiftTunnel V3 Relay Server (UDP + TCP)
Documentation=https://github.com/Swift-tunnel/swifttunnel-app
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/swifttunnel-relay
Restart=always
RestartSec=5
Environment=RUST_LOG=info
Environment=RELAY_AUTH_MODE=required
Environment=RELAY_TCP_ENABLED=true
Environment=RELAY_TUN_UDP=false
# Destination policy (src/dest_policy.rs): observe counts traffic outside the
# allowlist without dropping it, enforce drops it. Enforce needs the file
# written by update-dest-allowlist.sh.
Environment=RELAY_DEST_POLICY_MODE=observe
#Environment=RELAY_DEST_ALLOWLIST_FILE=/etc/swifttunnel/dest-allowlist.txt

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
DeviceAllow=/dev/net/tun rw
# CAP_NET_ADMIN is redundant under User=root but kept for future privilege-drop migration.
AmbientCapabilities=CAP_NET_ADMIN

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
